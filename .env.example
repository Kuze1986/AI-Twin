# Server (Express) — copy to .env in repo root for local dev
NODE_ENV=development
PORT=3001

# Anthropic (default provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

# Model tiers — defaults shown; override any tier individually
# fast:     lightweight extraction/memory consolidation calls
# balanced: main chat, DemoForge narration, style calibration
# powerful: deep reasoning (opt-in per call)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_BALANCED=claude-sonnet-4-6
ANTHROPIC_MODEL_POWERFUL=claude-opus-4-8

# Inference Provider Switching
# anthropic | openai | gemini | xai | kimi | openai_compatible
# When unset, auto-detects by key presence (Anthropic → OpenAI → Gemini → xAI → Kimi → Ollama)
KUZE_INFERENCE_PROVIDER=

# OpenAI (native SDK)
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_BALANCED=gpt-4o
OPENAI_MODEL_POWERFUL=gpt-4o

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_BALANCED=gemini-2.0-flash
GEMINI_MODEL_POWERFUL=gemini-2.0-flash

# xAI Grok (@bioloop/llm; GROK_API_KEY also accepted)
XAI_API_KEY=
XAI_MODEL_FAST=grok-4.5
XAI_MODEL_BALANCED=grok-4.5
XAI_MODEL_POWERFUL=grok-4.5

# Kimi / Moonshot (K2 fast, K3 balanced)
KIMI_API_KEY=
# MOONSHOT_API_KEY=
KIMI_MODEL_FAST=kimi-k2
KIMI_MODEL_BALANCED=kimi-k3
KIMI_MODEL_POWERFUL=kimi-k3

# OpenAI-Compatible Provider (when KUZE_INFERENCE_PROVIDER=openai_compatible)
# Supports Ollama, vLLM, LiteLLM, and other OpenAI-compatible endpoints
KUZE_OPENAI_BASE_URL=http://localhost:11434/v1
KUZE_OPENAI_API_KEY=

# Supabase (use service role only on the server; never expose in client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session + admin (change in production)
SESSION_SECRET=replace-with-long-random-string
ADMIN_PASSWORD=replace-with-strong-password

# Crucible simulator
CRUCIBLE_SIM_BASE_URL=https://your-crucible-sim.example.com
CRUCIBLE_SIM_API_KEY=replace-with-crucible-api-key

# CORS (comma-separated browser origins for the SPA, e.g. local + Railway)
CORS_ORIGIN=http://localhost:5173

# Chat
MAX_HISTORY_TOKENS=3000
CHAT_RATE_LIMIT_PER_MIN=20

# Memory consolidation (single-instance server recommended)
CONSOLIDATION_INTERVAL_MS=60000
INACTIVITY_MS=300000

# AI Peer keys — each sibling AI authenticates with its own key
# Set ILITA_PEER_KEY and STELE_PEER_KEY before enabling peer-to-peer messaging
ILITA_PEER_KEY=
STELE_PEER_KEY=

# Ilita API integration — set once Ilita's API details are confirmed
# Used for secondPassReview (value alignment check on sensitive outputs)
# Ilita (ilita-core). Also the governance gate for the Agent Fabric: charters are POSTed to
# ${ILITA_API_URL}/ilita/agents/review before an agent can act, and completed runs to
# /ilita/agents/audit. ILITA_API_KEY must equal Ilita's INTERNAL_API_KEY (sent as x-internal-key).
# Unset: agents requesting 'execute' autonomy stay in draft; 'propose'/'draft' agents activate
# provisionally with the gap recorded on the row.
ILITA_API_URL=
ILITA_API_KEY=

# Sentinel webhook — POST to this URL on every new pattern alert
# Works with Slack incoming webhooks, Discord, n8n, Zapier, etc.
SENTINEL_WEBHOOK_URL=

# Email channel — kuze@bioloopnexus.com via IONOS IMAP/SMTP
# Poller stays dormant until EMAIL_ENABLED=true AND credentials are set.
EMAIL_ENABLED=false
KUZE_EMAIL_ADDRESS=kuze@bioloopnexus.com
KUZE_EMAIL_USER=kuze@bioloopnexus.com
KUZE_EMAIL_PASSWORD=
IONOS_IMAP_HOST=imap.ionos.com
IONOS_IMAP_PORT=993
IONOS_SMTP_HOST=smtp.ionos.com
IONOS_SMTP_PORT=587
EMAIL_POLL_INTERVAL_MS=120000
EMAIL_DAILY_SEND_CAP=50
# Auto-send warm/known inbound replies after Sentinel clears (cold always needs approval)
EMAIL_AUTOSEND_WARM=true
THE_SHIFT_OUTREACH_FOOTER=

# Client (Vite) — prefix VITE_ ; use in client/.env or root .env if you merge
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
