# Server (Express) — copy to .env in repo root for local dev
NODE_ENV=development
PORT=3001

# Anthropic (default provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=

# Inference Provider Switching
# Set to 'anthropic' (default) or 'openai_compatible' to switch AI backends
KUZE_INFERENCE_PROVIDER=anthropic

# OpenAI-Compatible Provider (when KUZE_INFERENCE_PROVIDER=openai_compatible)
# Supports Ollama, vLLM, LiteLLM, and other OpenAI-compatible endpoints
KUZE_OPENAI_BASE_URL=http://localhost:11434/v1
KUZE_OPENAI_API_KEY=

# Supabase (use service role only on the server; never expose in client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session + admin (change in production)
SESSION_SECRET=replace-with-long-random-string
ADMIN_PASSWORD=replace-with-strong-password

# Crucible simulator
CRUCIBLE_SIM_BASE_URL=https://your-crucible-sim.example.com
CRUCIBLE_SIM_API_KEY=replace-with-crucible-api-key

# CORS (comma-separated browser origins for the SPA, e.g. local + Railway)
CORS_ORIGIN=http://localhost:5173

# Chat
MAX_HISTORY_TOKENS=3000
CHAT_RATE_LIMIT_PER_MIN=20

# Memory consolidation (single-instance server recommended)
CONSOLIDATION_INTERVAL_MS=60000
INACTIVITY_MS=300000

# AI Peer keys — each sibling AI authenticates with its own key
# Set ILITA_PEER_KEY and STELE_PEER_KEY before enabling peer-to-peer messaging
ILITA_PEER_KEY=
STELE_PEER_KEY=

# Ilita API integration — set once Ilita's API details are confirmed
# Used for secondPassReview (value alignment check on sensitive outputs)
ILITA_API_URL=
ILITA_API_KEY=

# Sentinel webhook — POST to this URL on every new pattern alert
# Works with Slack incoming webhooks, Discord, n8n, Zapier, etc.
SENTINEL_WEBHOOK_URL=

# Client (Vite) — prefix VITE_ ; use in client/.env or root .env if you merge
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
